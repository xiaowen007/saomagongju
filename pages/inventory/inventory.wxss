.summary-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 32rpx 24rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #5B6CFF;
  line-height: 1.2;
}

.summary-value.warning {
  color: #FF5B5B;
}

.summary-label {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}

.summary-divider {
  width: 2rpx;
  height: 60rpx;
  background: #eee;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.search-bar {
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}

.search-bar input {
  font-size: 28rpx;
  color: #333;
}

.inventory-list {
  margin-bottom: 16rpx;
}

.inventory-item {
  background: #F9FAFC;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.inventory-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.inventory-code {
  font-size: 24rpx;
  color: #999;
}

.inventory-quantity {
  font-size: 40rpx;
  font-weight: 700;
  color: #5B6CFF;
}

.inventory-quantity.warning {
  color: #FF5B5B;
}
