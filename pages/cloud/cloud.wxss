.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.cloud-input {
  width: 100%;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.tip {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.sync-row {
  display: flex;
  gap: 20rpx;
}

.sync-row .btn-secondary {
  flex: 1;
}

.status-text {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-top: 24rpx;
}

.status-text.ready {
  color: #07C160;
}
