# 微信小程序密钥配置模板（请勿填写真实值到本文件）
# 复制本文件为 .env 并在其中填写真实值，.env 已被 .gitignore 忽略，不会提交。
# 在 GitHub Actions / 云开发环境变量中使用时，请直接填到 Secrets，不要硬编码。

# 小程序 AppID（公开信息，也可写在 project.config.json）
WX_APPID=your_appid_here

# 小程序密钥 AppSecret（极度机密，仅用于服务端调用微信接口，
# 切勿提交；推荐放在 GitHub Secrets 或云开发控制台环境变量）
WX_APPSECRET=your_appsecret_here

# 云开发环境 ID（如使用微信云开发）
WX_CLOUD_ENV=your_cloud_env_here
